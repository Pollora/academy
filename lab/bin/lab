#!/usr/bin/env bash
#
# Pollora Academy lab: install the practice project and grade the exercises.
#
#   lab setup            create the project (DDEV) and seed its content
#   lab ai-setup         install Nectar (and Laravel Boost) and register its MCP server, for Claude Code
#   lab check  <NN>      run the tests of exercise NN
#   lab reset  <NN>      put exercise NN back to its starting point
#   lab solve  <NN>      copy the solution of exercise NN (spoiler)
#   lab verify <NN>      maintainers: the starter must fail, the solution must pass
#   lab capture <id>     record a scripted session as a TerminalReplay fixture (site/src/data/captures)
#   lab capture --check [id]   re-record and fail if the output drifted from the committed fixture
set -euo pipefail

LAB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Physical path: DDEV refuses a project reached through a symlink
PROJECT_DIR="$(cd -P "$LAB_DIR/academy-lab" 2>/dev/null && pwd -P || echo "$LAB_DIR/academy-lab")"
POLLORA_CONSTRAINT='^13.40'
CAPTURES_DIR="$LAB_DIR/captures"
FIXTURES_DIR="$(cd "$LAB_DIR/.." && pwd)/site/src/data/captures"

die() { echo "lab: $*" >&2; exit 1; }

exercise_dir() {
  local number="${1:-}"
  [[ "$number" =~ ^[0-9]{2}$ ]] || die "give the exercise number, for example: lab $2 01"
  local match=("$LAB_DIR"/exercises/"$number"-*/)
  [[ -d "${match[0]}" ]] || die "no exercise $number"
  echo "${match[0]%/}"
}

require_project() {
  [[ -d "$PROJECT_DIR/.ddev" ]] || die "the project is not installed yet: run 'lab setup' first"
}

in_project() { (cd "$PROJECT_DIR" && "$@"); }

# The base class and the shared assertions of the exercises are copied into the project's tests/
copy_support_tests() {
  mkdir -p "$PROJECT_DIR/tests"
  cp "$LAB_DIR"/support/tests/*.php "$PROJECT_DIR/tests/"
}

cmd_setup() {
  command -v ddev >/dev/null || die "DDEV is required: https://ddev.readthedocs.io"
  command -v pollora >/dev/null || die "the Pollora CLI is required: composer global require pollora/cli"

  if [[ ! -d "$PROJECT_DIR/.ddev" ]]; then
    (cd "$LAB_DIR" && pollora new academy-lab --ddev --stable --no-interaction)
  fi

  in_project ddev composer update "pollora/framework:$POLLORA_CONSTRAINT" --with-all-dependencies --no-interaction

  if [[ -z "$(in_project ddev wp post list --post_type=page --name=contact --format=ids)" ]]; then
    in_project ddev wp post create --post_type=page --post_title=Contact --post_name=contact --post_status=publish --porcelain >/dev/null
  fi

  mkdir -p "$PROJECT_DIR/tests/Feature/Lab"
  copy_support_tests

  echo "Lab ready: $(in_project ddev composer show pollora/framework | grep -E '^versions' | tr -d '*')"
  echo "Next: lab reset 01, then read the exercise on the site and run: lab check 01"
}

# Give Claude Code the context of a Pollora project: Nectar (which requires Laravel Boost) and its MCP server.
# Safe to run again: what is installed or registered is left alone. `boost:install` is interactive and stays a manual step.
cmd_ai_setup() {
  require_project
  command -v jq >/dev/null || die "jq is required to write .mcp.json"
  in_project ddev start >/dev/null 2>&1 || die "ddev could not start the project"

  if in_project ddev composer show pollora/nectar >/dev/null 2>&1; then
    echo "pollora/nectar is already installed."
  else
    in_project ddev composer require pollora/nectar --dev --no-interaction
  fi

  # The server entry of the documentation (guides/ai-coding-agents-wordpress); inside the container for a DDEV project
  local entry='{"command":"php","args":["artisan","nectar:mcp"]}'
  if [[ -d "$PROJECT_DIR/.ddev" ]]; then
    entry='{"command":"ddev","args":["exec","php","artisan","nectar:mcp"]}'
  fi
  local file="$PROJECT_DIR/.mcp.json"
  if [[ -f "$file" ]] && jq -e '.mcpServers["pollora-nectar"]' "$file" >/dev/null 2>&1; then
    echo ".mcp.json already registers pollora-nectar."
  else
    [[ -f "$file" ]] || echo '{}' > "$file"
    jq --argjson entry "$entry" '.mcpServers = ((.mcpServers // {}) + {"pollora-nectar": $entry})' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
    echo "pollora-nectar registered in .mcp.json."
  fi

  cat <<'MESSAGE'

One step is left, and it is yours: Laravel Boost writes the guidelines and the skills Claude Code reads,
and its installer asks questions. In lab/academy-lab, run:

    ddev exec php artisan boost:install

Select your agent (Claude Code) and, when Boost asks about third-party packages, select pollora/nectar.
(Alternative: put {"packages": ["pollora/nectar"]} in boost.json, then run: ddev exec php artisan boost:update)

Then start Claude Code from lab/academy-lab.
MESSAGE
}

cmd_check() {
  local dir; dir="$(exercise_dir "${1:-}" check)"
  require_project
  rm -rf "$PROJECT_DIR/tests/Feature/Lab" && mkdir -p "$PROJECT_DIR/tests/Feature/Lab"
  cp "$dir"/tests/*.php "$PROJECT_DIR/tests/Feature/Lab/"
  copy_support_tests
  # Classes added or edited since the last run must be discovered again
  in_project ddev exec php artisan discovery:clear >/dev/null
  # WordPress cannot be loaded twice in one process: one process per test
  in_project ddev exec vendor/bin/phpunit --process-isolation tests/Feature/Lab
}

cmd_reset() {
  local dir; dir="$(exercise_dir "${1:-}" reset)"
  require_project
  # What a previous attempt left (an agent names its files as it likes): the exercise lists those paths
  if [[ -f "$dir/reset-paths" ]]; then
    while IFS= read -r path; do
      [[ "$path" =~ ^app/[A-Za-z0-9_/.-]+$ && "$path" != *..* ]] || continue
      rm -rf "${PROJECT_DIR:?}/$path"
    done < "$dir/reset-paths"
  fi
  cp -r "$dir"/starter/. "$PROJECT_DIR"/
  echo "Exercise ${1} is back to its starting point."
}

cmd_solve() {
  local dir; dir="$(exercise_dir "${1:-}" solve)"
  require_project
  cp -r "$dir"/solution/. "$PROJECT_DIR"/
  echo "Solution of exercise ${1} copied into the project."
}

cmd_verify() {
  local number="${1:-}"
  cmd_reset "$number" >/dev/null
  if cmd_check "$number" >/dev/null 2>&1; then
    die "exercise $number: the starter passes, the test checks nothing"
  fi
  cmd_solve "$number" >/dev/null
  cmd_check "$number" >/dev/null 2>&1 || { cmd_check "$number" || true; die "exercise $number: the solution fails"; }
  cmd_reset "$number" >/dev/null
  echo "Exercise $number: the starter fails, the solution passes."
}

# The line to run in the project for a step of a capture: `pollora <name> …` is relayed by the Pollora CLI
# to `php artisan pollora:<name> …`, any other command (`php artisan …`) is run as written.
capture_command_line() {
  local command="$1"
  case "$command" in
    "pollora "*) echo "php artisan pollora:${command#pollora } --ansi" ;;
    "php artisan "*) echo "$command --ansi" ;;
    *) die "capture: a step must start with 'pollora ' or 'php artisan ': $command" ;;
  esac
}

# Record one capture into <output file>. The project is put aside (isolate) and back (teardown) whatever happens.
record_capture() {
  local id="$1" output="$2"
  local definition="$CAPTURES_DIR/$id.json"
  [[ -f "$definition" ]] || die "no capture $id (expected lab/captures/$id.json)"
  command -v jq >/dev/null || die "jq is required to read lab/captures/$id.json"
  command -v node >/dev/null || die "Node is required to write the fixture"
  require_project
  in_project ddev start >/dev/null 2>&1 || die "ddev could not start the project"

  local work stash; work="$(mktemp -d)"; stash="$work/stash"; mkdir -p "$stash" "$work/raw"
  local isolated=() path index=0

  restore_project() {
    jq -r '.teardown[]?' "$definition" | while IFS= read -r line; do
      in_project ddev exec bash -c "$line" </dev/null >/dev/null 2>&1 || true
    done
    local i=0
    for path in "${isolated[@]:-}"; do
      [[ -n "$path" ]] || continue
      rm -rf "${PROJECT_DIR:?}/$path"
      mv "$stash/$i" "$PROJECT_DIR/$path"
      i=$((i + 1))
    done
    isolated=()
    in_project ddev exec php artisan discovery:clear >/dev/null 2>&1 || true
    rm -rf "$work"
  }
  trap restore_project EXIT

  # Exercise files left in the project would end up in the output: put them aside for the recording
  while IFS= read -r path; do
    [[ -n "$path" && -e "$PROJECT_DIR/$path" ]] || continue
    mv "$PROJECT_DIR/$path" "$stash/$index"
    isolated+=("$path"); index=$((index + 1))
  done < <(jq -r '.isolate[]?' "$definition")

  in_project ddev exec php artisan discovery:clear >/dev/null 2>&1
  while IFS= read -r line; do
    in_project ddev exec bash -c "$line" </dev/null >/dev/null 2>&1 || die "capture $id: setup failed: $line"
  done < <(jq -r '.setup[]?' "$definition")

  local step=0 command line code
  while IFS= read -r command; do
    line="$(capture_command_line "$command")"
    code=0
    in_project ddev exec bash -c "$line 2>&1" </dev/null > "$work/raw/$step.out" 2>/dev/null || code=$?
    echo "$code" > "$work/raw/$step.code"
    step=$((step + 1))
  done < <(jq -r '.steps[].command' "$definition")

  local version
  version="$(in_project ddev composer show pollora/framework 2>/dev/null | sed -n 's/^versions *: *\*\? *v\?\([0-9][0-9.]*\).*/\1/p' | head -1)"
  [[ -n "$version" ]] || version="unknown"
  node "$LAB_DIR/support/capture.mjs" build "$definition" "$work/raw" "$output" "$version"

  restore_project
  trap - EXIT
}

cmd_capture() {
  mkdir -p "$FIXTURES_DIR"
  if [[ "${1:-}" == "--check" ]]; then
    local ids=() failed=0 id
    if [[ -n "${2:-}" ]]; then ids=("$2"); else for f in "$CAPTURES_DIR"/*.json; do ids+=("$(basename "$f" .json)"); done; fi
    local tmp; tmp="$(mktemp -d)"
    for id in "${ids[@]}"; do
      [[ -f "$FIXTURES_DIR/$id.json" ]] || { echo "capture $id: no committed fixture, run: lab capture $id" >&2; failed=1; continue; }
      record_capture "$id" "$tmp/$id.json"
      if node "$LAB_DIR/support/capture.mjs" diff "$FIXTURES_DIR/$id.json" "$tmp/$id.json"; then
        echo "capture $id: up to date"
      else
        failed=1
      fi
    done
    rm -rf "$tmp"
    [[ "$failed" -eq 0 ]] || die "captures drifted: review the change, then re-record with 'lab capture <id>'"
    return 0
  fi
  local id="${1:-}"
  [[ "$id" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "give the capture id, for example: lab capture doctor"
  record_capture "$id" "$FIXTURES_DIR/$id.json"
  echo "Recorded site/src/data/captures/$id.json"
}

case "${1:-}" in
  setup)  cmd_setup ;;
  ai-setup) cmd_ai_setup ;;
  check)  cmd_check "${2:-}" ;;
  reset)  cmd_reset "${2:-}" ;;
  solve)  cmd_solve "${2:-}" ;;
  verify) cmd_verify "${2:-}" ;;
  capture) shift; cmd_capture "${1:-}" "${2:-}" ;;
  *) sed -n "2,11p" "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
