---
// Language chooser: the site has no root locale, so "/" offers the two.
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/geist';
---
<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Pollora Academy</title>
		<link rel="icon" href="/favicon.svg" />
	</head>
	<body>
		<main>
			<h1>Pollora Academy</h1>
			<p>Pollora 13 &amp; Nectar : apprendre en pratiquant · Learn by doing</p>
			<nav>
				<a href="/fr/">Français</a>
				<a href="/en/">English</a>
			</nav>
		</main>
	</body>
</html>
<style is:global>
	:root { color-scheme: light dark; }
	body {
		margin: 0; min-height: 100vh; display: grid; place-items: center;
		font-family: 'Geist Variable', system-ui, sans-serif;
		background: oklch(16% 0.026 295); color: oklch(97% 0.006 30);
	}
	main { text-align: center; padding: 1.5rem; }
	h1 {
		font-family: 'Space Grotesk Variable', system-ui, sans-serif; font-size: clamp(2.5rem, 8vw, 4.5rem); margin: 0 0 .5rem;
		background: linear-gradient(135deg, #fb196d, #ff314c 25%, #ff5334 50%, #ff8c12);
		-webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
	}
	nav { display: flex; gap: 1rem; justify-content: center; margin-top: 2rem; }
	a {
		padding: .75rem 1.75rem; border-radius: 999px; border: 1px solid oklch(46% 0.026 295);
		color: inherit; text-decoration: none; font-weight: 600;
	}
	a:hover, a:focus-visible { border-color: oklch(68% 0.2 32); outline: none; }
</style>
